  "devDependencies": {
    "@angular-eslint/builder": "22.2.0",
    "@angular-eslint/eslint-plugin": "22.2.0",
    "@angular-eslint/eslint-plugin-template": "22.2.0",
    "@angular-eslint/template-parser": "22.2.0",
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.0",
    "@graphql-codegen/near-operation-file-preset": "4.0.0",
    "@graphql-codegen/typescript": "5.0.8",
    "@graphql-codegen/typescript-apollo-angular": "5.0.1",
    "@graphql-codegen/typescript-operations": "5.0.8",
    "@tailwindcss/postcss": "4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.2.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-multiline-arrays": "4.1.11",
    "prettier-plugin-organize-imports": "4.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@progress/kendo-licensing": true,
    "esbuild": true,
    "fsevents": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}

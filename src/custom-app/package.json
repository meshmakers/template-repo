{
  "name": "custom-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "setup-license": "node scripts/setup-license.js",
    "prestart": "node scripts/check-dev-certs.js && npm run setup-license",
    "start": "ng serve",
    "build": "npm run lint && ng build",
    "prebuild:prod": "npm run setup-license",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration ci",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "codegen": "graphql-codegen --config codegen.yml",
    "codegen:sample": "graphql-codegen --config codegen.sample.yml",
    "test:codegen": "node --test scripts/sample-schema.test.js scripts/check-dev-certs.test.js",
    "postinstall": "node src/environments/version.ts",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/localize": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@apollo/client": "4.3.8",
    "@meshmakers/octo-services": "*",
    "@meshmakers/octo-ui": "*",
    "@meshmakers/shared-auth": "*",
    "@meshmakers/shared-services": "*",
    "@meshmakers/shared-ui": "*",
    "@ngx-translate/core": "17.0.0",
    "@progress/kendo-angular-buttons": "24.2.2",
    "@progress/kendo-angular-common": "24.2.2",
    "@progress/kendo-angular-conversational-ui": "24.2.2",
    "@progress/kendo-angular-dateinputs": "24.2.2",
    "@progress/kendo-angular-dialog": "24.2.2",
    "@progress/kendo-angular-dropdowns": "24.2.2",
    "@progress/kendo-angular-excel-export": "24.2.2",
    "@progress/kendo-angular-grid": "24.2.2",
    "@progress/kendo-angular-icons": "24.2.2",
    "@progress/kendo-angular-indicators": "24.2.2",
    "@progress/kendo-angular-inputs": "24.2.2",
    "@progress/kendo-angular-intl": "24.2.2",
    "@progress/kendo-angular-l10n": "24.2.2",
    "@progress/kendo-angular-label": "24.2.2",
    "@progress/kendo-angular-layout": "24.2.2",
    "@progress/kendo-angular-menu": "24.2.2",
    "@progress/kendo-angular-navigation": "24.2.2",
    "@progress/kendo-angular-notification": "24.2.2",
    "@progress/kendo-angular-pager": "24.2.2",
    "@progress/kendo-angular-pdf-export": "24.2.2",
    "@progress/kendo-angular-popup": "24.2.2",
    "@progress/kendo-angular-progressbar": "24.2.2",
    "@progress/kendo-angular-toolbar": "24.2.2",
    "@progress/kendo-angular-tooltip": "24.2.2",
    "@progress/kendo-angular-treeview": "24.2.2",
    "@progress/kendo-angular-upload": "24.2.2",
    "@progress/kendo-angular-utils": "24.2.2",
    "@progress/kendo-data-query": "1.7.4",
    "@progress/kendo-drawing": "1.25.7",
    "@progress/kendo-licensing": "1.13.1",
    "@progress/kendo-svg-icons": "^4.12.0",
    "@progress/kendo-theme-material": "^14.1.0",
    "angular-oauth2-oidc": "22.0.2",
    "apollo-angular": "14.2.0",
    "cron-parser": "5.10.6",
    "cronstrue": "3.43.0",
    "date-fns": "4.4.0",
    "flag-icons": "7.6.0",
    "graphql": "16.15.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "tus-js-client": "4.3.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.8.0",
    "@angular-eslint/eslint-plugin": "22.8.0",
    "@angular-eslint/eslint-plugin-template": "22.8.0",
    "@angular-eslint/template-parser": "22.8.0",
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/near-operation-file-preset": "6.0.2",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-apollo-angular": "6.0.0",
    "@graphql-codegen/typescript-operations": "7.0.2",
    "@tailwindcss/postcss": "4.3.5",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-multiline-arrays": "4.1.11",
    "prettier-plugin-organize-imports": "4.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@progress/kendo-licensing": true,
    "esbuild": true,
    "fsevents": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}

{
  "name": "custom-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "setup-license": "node scripts/setup-license.js",
    "prestart": "npm run setup-license",
    "start": "ng serve",
    "build": "npm run lint && ng build",
    "prebuild:prod": "npm run setup-license",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration ci",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "codegen": "graphql-codegen --config codegen.yml",
    "postinstall": "node src/environments/version.ts",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/localize": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/router": "22.1.5",
    "@apollo/client": "4.2.12",
    "@meshmakers/octo-services": "*",
    "@meshmakers/octo-ui": "*",
    "@meshmakers/shared-auth": "*",
    "@meshmakers/shared-services": "*",
    "@meshmakers/shared-ui": "*",
    "@ngx-translate/core": "17.0.0",
    "@progress/kendo-angular-buttons": "24.1.0",
    "@progress/kendo-angular-common": "24.1.0",
    "@progress/kendo-angular-conversational-ui": "24.1.0",
    "@progress/kendo-angular-dateinputs": "24.1.0",
    "@progress/kendo-angular-dialog": "24.1.0",
    "@progress/kendo-angular-dropdowns": "24.1.0",
    "@progress/kendo-angular-excel-export": "24.1.0",
    "@progress/kendo-angular-grid": "24.1.0",
    "@progress/kendo-angular-icons": "24.1.0",
    "@progress/kendo-angular-indicators": "24.1.0",
    "@progress/kendo-angular-inputs": "24.1.0",
    "@progress/kendo-angular-intl": "24.1.0",
    "@progress/kendo-angular-l10n": "24.1.0",
    "@progress/kendo-angular-label": "24.1.0",
    "@progress/kendo-angular-layout": "24.1.0",
    "@progress/kendo-angular-menu": "25.0.0",
    "@progress/kendo-angular-navigation": "24.1.0",
    "@progress/kendo-angular-notification": "24.1.0",
    "@progress/kendo-angular-pager": "24.1.0",
    "@progress/kendo-angular-pdf-export": "24.1.0",
    "@progress/kendo-angular-popup": "24.1.0",
    "@progress/kendo-angular-progressbar": "24.1.0",
    "@progress/kendo-angular-toolbar": "24.1.0",
    "@progress/kendo-angular-tooltip": "24.1.0",
    "@progress/kendo-angular-treeview": "24.1.0",
    "@progress/kendo-angular-upload": "24.1.0",
    "@progress/kendo-angular-utils": "24.1.0",
    "@progress/kendo-data-query": "1.7.3",
    "@progress/kendo-drawing": "1.25.0",
    "@progress/kendo-licensing": "1.11.0",
    "@progress/kendo-svg-icons": "^4.9.0",
    "@progress/kendo-theme-default": "^14.1.0",
    "angular-oauth2-oidc": "22.0.2",
    "apollo-angular": "14.2.0",
    "cron-parser": "5.10.0",
    "cronstrue": "3.24.0",
    "date-fns": "4.4.0",
    "flag-icons": "7.5.0",
    "graphql": "16.14.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "tus-js-client": "4.3.1",
    "zone.js": "0.16.3"
